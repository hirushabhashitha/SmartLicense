{
  "openapi": "3.0.1",
  "info": {
    "title": "SmartLicenseAPI",
    "version": "1.0"
  },
  "paths": {
    "/api/Auth/register": {
      "post": {
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/User"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/User"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/User"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/AuthRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/DataCardClick": {
      "get": {
        "tags": [
          "DataCardClick"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/DrivingSchools": {
      "get": {
        "tags": [
          "DrivingSchools"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/LicenseApplication/submit": {
      "post": {
        "tags": [
          "LicenseApplication"
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "required": [
                  "BirthCertificate",
                  "IdNumber",
                  "IdType",
                  "MedicalCertificate",
                  "PhoneNumber",
                  "Secretariat",
                  "Surname"
                ],
                "type": "object",
                "properties": {
                  "IdType": {
                    "type": "string"
                  },
                  "IdNumber": {
                    "type": "string"
                  },
                  "Surname": {
                    "type": "string"
                  },
                  "OtherNames": {
                    "type": "string"
                  },
                  "PrintedName": {
                    "type": "string"
                  },
                  "HeightFeet": {
                    "type": "integer",
                    "format": "int32"
                  },
                  "HeightInches": {
                    "type": "integer",
                    "format": "int32"
                  },
                  "BloodGroup": {
                    "type": "string"
                  },
                  "OrganDonor": {
                    "type": "string"
                  },
                  "Address": {
                    "type": "string"
                  },
                  "PhoneNumber": {
                    "type": "string"
                  },
                  "Secretariat": {
                    "type": "string"
                  },
                  "Restrictions": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "BirthCertificate": {
                    "type": "string",
                    "format": "binary"
                  },
                  "MedicalCertificate": {
                    "type": "string",
                    "format": "binary"
                  },
                  "UserId": {
                    "type": "integer",
                    "format": "int32"
                  }
                }
              },
              "encoding": {
                "IdType": {
                  "style": "form"
                },
                "IdNumber": {
                  "style": "form"
                },
                "Surname": {
                  "style": "form"
                },
                "OtherNames": {
                  "style": "form"
                },
                "PrintedName": {
                  "style": "form"
                },
                "HeightFeet": {
                  "style": "form"
                },
                "HeightInches": {
                  "style": "form"
                },
                "BloodGroup": {
                  "style": "form"
                },
                "OrganDonor": {
                  "style": "form"
                },
                "Address": {
                  "style": "form"
                },
                "PhoneNumber": {
                  "style": "form"
                },
                "Secretariat": {
                  "style": "form"
                },
                "Restrictions": {
                  "style": "form"
                },
                "BirthCertificate": {
                  "style": "form"
                },
                "MedicalCertificate": {
                  "style": "form"
                },
                "UserId": {
                  "style": "form"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/LicenseApplication/user/{Id}": {
      "get": {
        "tags": [
          "LicenseApplication"
        ],
        "parameters": [
          {
            "name": "Id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/LicenseApplication/all": {
      "get": {
        "tags": [
          "LicenseApplication"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/LicenseApplication/details/{id}": {
      "get": {
        "tags": [
          "LicenseApplication"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/LicenseApplication/updateStatus/{id}": {
      "put": {
        "tags": [
          "LicenseApplication"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateStatusRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateStatusRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateStatusRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/LicenseApplication/download/{fileName}": {
      "get": {
        "tags": [
          "LicenseApplication"
        ],
        "parameters": [
          {
            "name": "fileName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/LicenseApplication/view/{fileName}": {
      "get": {
        "tags": [
          "LicenseApplication"
        ],
        "parameters": [
          {
            "name": "fileName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApplicationTypes": {
        "enum": [
          0,
          1,
          2
        ],
        "type": "integer",
        "format": "int32"
      },
      "AuthRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "maxLength": 150,
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "password": {
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "UpdateStatusRequest": {
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/ApplicationTypes"
          }
        },
        "additionalProperties": false
      },
      "User": {
        "required": [
          "email",
          "name",
          "password",
          "role"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "email": {
            "maxLength": 150,
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "password": {
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/UserRole"
          }
        },
        "additionalProperties": false
      },
      "UserRole": {
        "enum": [
          1,
          2
        ],
        "type": "integer",
        "format": "int32"
      }
    }
  }
}